# Copiar a .env y completar con valores reales. Nunca commitear .env con secretos.

# PostgreSQL
DB_HOST=database
DB_PORT=5432
DB_USERNAME=pulso
DB_PASSWORD=
DB_NAME=pulso
DB_ENGINE=postgresql
DB_DRIVER=asyncpg

# Valkey (fork de Redis bajo la Linux Foundation, no cambiar por Redis)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# Orígenes permitidos por CORS, separados por coma. Vacío = ningún origen cross-site permitido.
ALLOWED_ORIGINS=

# "development" o "production". Controla modo debug, HSTS y log de OTP en claro.
ENV=development

# Secreto de firma de JWT (HS256). Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_TOKEN_SECRET=

# Pepper de contraseñas, en base64 urlsafe. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PASSWORD_PEPPER=

# Wompi Colombia (única pasarela aceptada en Pulso). Llaves de
# sandbox/produccion en el dashboard de comercios de Wompi.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Login con Google (Google Identity Services, id_token verificado en backend
# contra las llaves públicas de Google -- no se usa client secret).
GOOGLE_CLIENT_ID=

# Resend (correo transaccional). Usado hoy solo para recuperación de password.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Origen del frontend, para armar el enlace de recuperación de password.
FRONTEND_URL=http://localhost:5173

# Meta Embedded Signup (WhatsApp Business). App Dashboard de developers.facebook.com.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v27.0

# Llave de cifrado (Fernet) de credenciales de proveedor guardadas en BD,
# hoy el token de acceso de Meta por conexión de WhatsApp. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENCIALES_CIPHER_KEY=

# Identidad de WhatsApp de PLATAFORMA (OTP de login, nunca de un tenant).
# System user de Meta con acceso total sobre la app y la cuenta de WhatsApp
# de Pulso. Ver /CLAUDE.md "OTP de inicio de sesión: gasto interno".
META_ACCESS_TOKEN=
META_PLATFORM_PHONE_NUMBER_ID=
META_PLATFORM_WABA_ID=

# SMS/RCS (Sent.dm, fase 9). Token único de plataforma -- el tenant nunca
# aporta sus propias credenciales. API v3: POST /v3/messages.
SENTDM_API_KEY=
SENTDM_BASE_URL=https://api.sent.dm
