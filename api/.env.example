# Copiar a .env y completar con valores reales. Nunca commitear .env con secretos.

# PostgreSQL
DB_HOST=database
DB_PORT=5432
DB_USERNAME=pulso
DB_PASSWORD=
DB_NAME=pulso
DB_ENGINE=postgresql
DB_DRIVER=asyncpg

# Valkey (fork de Redis bajo la Linux Foundation, no cambiar por Redis)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# Orígenes permitidos por CORS, separados por coma. Vacío = ningún origen cross-site permitido.
ALLOWED_ORIGINS=

# "development" o "production". Controla modo debug, HSTS y log de OTP en claro.
ENV=development

# Secreto de firma de JWT (HS256). Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_TOKEN_SECRET=

# Pepper de contraseñas, en base64 urlsafe. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PASSWORD_PEPPER=

# Wompi Colombia (única pasarela aceptada en Pulso). Llaves de
# sandbox/produccion en el dashboard de comercios de Wompi.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
