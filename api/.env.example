# Copiar a .env y completar con valores reales. Nunca commitear .env con secretos.

# PostgreSQL
DB_HOST=database
DB_PORT=5432
DB_USERNAME=pulso
DB_PASSWORD=
DB_NAME=pulso
DB_ENGINE=postgresql
DB_DRIVER=asyncpg

# Valkey (fork de Redis, ver /CLAUDE.md "Valkey, no Redis")
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# Orígenes permitidos por CORS, separados por coma. Vacío = ningún origen cross-site permitido.
ALLOWED_ORIGINS=
