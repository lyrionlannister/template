[importlinter]
root_package = app

[importlinter:contract:auth-layers]
name = Capas de auth
type = layers
layers =
    app.auth.controllers
    app.auth.services
    app.auth.repositories
    app.auth.models

[importlinter:contract:audiences-layers]
name = Capas de audiences
type = layers
layers =
    app.audiences.controllers
    app.audiences.services
    app.audiences.repositories
    app.audiences.models

[importlinter:contract:contacts-layers]
name = Capas de contacts
type = layers
layers =
    app.contacts.controllers
    app.contacts.services
    app.contacts.repositories
    app.contacts.models

[importlinter:contract:messaging-layers]
name = Capas de messaging
type = layers
layers =
    app.messaging.controllers
    app.messaging.services
    app.messaging.repositories
    app.messaging.models

[importlinter:contract:app_platform-layers]
name = Capas de app_platform
type = layers
layers =
    app.app_platform.controllers
    app.app_platform.services
    app.app_platform.repositories
    app.app_platform.models

[importlinter:contract:billing-layers]
name = Capas de billing
type = layers
layers =
    app.billing.controllers
    app.billing.services
    app.billing.repositories
    app.billing.models

[importlinter:contract:auth-no-cross-domain]
name = auth no importa repositories/models de otros dominios
type = forbidden
allow_indirect_imports = True
source_modules =
    app.auth
forbidden_modules =
    app.audiences.repositories
    app.audiences.models
    app.contacts.repositories
    app.contacts.models
    app.messaging.repositories
    app.messaging.models
    app.app_platform.repositories
    app.app_platform.models
    app.billing.repositories
    app.billing.models

[importlinter:contract:audiences-no-cross-domain]
name = audiences no importa repositories/models de otros dominios
type = forbidden
allow_indirect_imports = True
source_modules =
