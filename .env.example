# Copiar a .env y completar con valores reales. Nunca commitear .env con secretos.
# Leido por docker-compose.yaml (podman compose) para los contenedores database, valkey y api.

DB_NAME=pulso
DB_USERNAME=pulso
DB_PASSWORD=
DB_PORT=5432
DB_ENGINE=postgresql
DB_DRIVER=asyncpg

VALKEY_PASSWORD=
VALKEY_PORT=6379

API_PORT=8000

ALLOWED_ORIGINS=
